# Google API Configuration for MCP Server
# =========================================
# Copy this file to .env and fill in your values

# Google Spreadsheet ID
# Get this from the Google Sheets URL:
# https://docs.google.com/spreadsheets/d/[SPREADSHEET_ID]/edit
# Create a new Google Sheet at: https://sheets.google.com
FEES_EXPLAINER_SPREADSHEET_ID=your_spreadsheet_id_here

# Google OAuth Credentials
# Download from: https://console.cloud.google.com/apis/credentials
# Save as credentials.json in the project directory
GOOGLE_CREDENTIALS_PATH=credentials.json

# Google OAuth Token
# Auto-generated when you run: python setup_google_credentials.py --auth
# No need to create this manually
GOOGLE_TOKEN_PATH=token.json
